# Frontend production environment
# Copy to .env.production on the server and replace with real values.

# Public URL used by browser-executed code.
# Prefer your public domain. If you only have the VPS IP, use it here.
NEXT_PUBLIC_API_URL=https://example.com

# Server-side URL used by Next route handlers, rewrites and SSR.
# This may be an internal address if frontend and backend live on the same VPS.
BACKEND_URL=http://127.0.0.1:5000
