{
  "name": "frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3200 next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "cross-env NODE_ENV=production next start -p 3200",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "analyze": "yarn build",
    "analyze:webpack": "cross-env ANALYZE=true cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "clean-logs": "node scripts/cleanup-console-logs.js",
    "migrate-urls": "node scripts/migrate-urls.js",
    "check:all": "yarn check --integrity && yarn audit && npx next info && echo ' Todo verificado correctamente'"
  },
